{
  "rewrites": [
    {
      "source": "/api/mistral/:path*",
      "destination": "https://api.mistral.ai/:path*"
    },
    {
      "source": "/api/groq/:path*",
      "destination": "https://api.groq.com/openai/v1/:path*"
    },
    {
      "source": "/api/deepgram/:path*",
      "destination": "https://api.deepgram.com/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
